#iven an array nums and an integer k. 
# R﻿eturn true if there exist subsequences such that the sum of all elements in subsequences is equal to k else false.


#Example 1

#Input : nums = [1, 2, 3, 4, 5] , k = 8
#Output : Yes
#Explanation : The subsequences like [1, 2, 5] , [1, 3, 4] , [3, 5] sum up to 8.

#Example 2

#Input : nums = [4, 3, 9, 2] , k = 10
#Output : No
#Explanation : No subsequence can sum up to 10.


nums = list(map(int, input("Enter array elements separated by space: ").split()))
k = int(input("Enter value of k: "))

dp = [False] * (k + 1)
dp[0] = True  

for num in nums:
    for s in range(k, num - 1, -1):
        if dp[s - num]:
            dp[s] = True

if dp[k]:
    print("Yes")
else:
    print("No")
