#Given an array nums and an integer k.
# Return the number of non-empty subsequences of nums such that the sum of all elements in the subsequence is equal to k.


#Example 1

#Input : nums = [4, 9, 2, 5, 1] , k = 10
#Output : 2
#Explanation : The possible subsets with sum k are [9, 1] , [4, 5, 1].

#Example 2

#Input : nums = [4, 2, 10, 5, 1, 3] , k = 5
#Output : 3
#Explanation : The possible subsets with sum k are [4, 1] , [2, 3] , [5].


nums = list(map(int, input("Enter array elements separated by space: ").split()))
k = int(input("Enter value of k: "))

dp = [0] * (k + 1)
dp[0] = 1  

for num in nums:
    for s in range(k, num - 1, -1):
        dp[s] += dp[s - num]

print(dp[k])
